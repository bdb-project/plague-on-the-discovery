has light;

!----------------------------------------
! Recreation room
!----------------------------------------
Object "recreation room" room14
with
  name 'recreation' 'room',
  description "This room was probably used between shifts by the medics that worked in this part of the ship.",
has scenery;

!----------------------------------------
! Sofas
!----------------------------------------
Object "sofas" room14
with
  name 'sofas',
  description
  [;
    print "The sofas look very comfy. You guess they needed to be made that way to provide some comfort during the long periods away from home. ";
    <<Search self>>;
  ],
  before
  [;
    Enter:
      if (verb_word == 'sit')
        "You sit on one the sofas to try it. Yep, it sure is comfy, but you have no time to waste sitting around on a sofa, so you stand up again.";
      if (verb_word == 'stand')
        "The sofas might be all messed up, but that doesn't mean you can stand on them and mess them up even more.";
      <<Sleep>>;
    ],
has enterable pluralname scenery supporter;

!----------------------------------------
! Gaming tables
