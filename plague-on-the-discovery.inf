!========================================
! Room 21: Strategic Meeting Room
!========================================
Object room21 "Strategic Meeting Room"
with
  description "The room you're in now is intended for strategic meetings of high-ranking personnel. A large table and some chairs are all the furniture in the room. On one of the walls stands a whiteboard with some writing on it. The only exit is to the north.",
  n_to
  [;
    if (corpse21 hasnt general)
      StopDaemon(corpse21);
    return room20;
  ],
has light;

!----------------------------------------
! Strategic meeting room
