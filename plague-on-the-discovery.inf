!========================================
! Room 11: Cockpit
!========================================
Object room11 "Cockpit"
with
  description "You're in the cockpit of the spaceship. Two ergonomically-designed seats face the complex control instrumentation of the Discovery. The only exit is west.",
  w_to room10,
has light;

!----------------------------------------
! Cockpit
!----------------------------------------
Object "cockpit" room11
with
  name 'cockpit' 'screens' 'levers' 'buttons' 'throttles',
  description
  [;
    print "The cockpit looks pretty bare, as there aren't many levers, buttons and throttles. It mostly contains a bunch of screens where the pilot can enter data or monitor the ship's functions.";
    if (disengage_lever hasnt general)
      print (string)DISENGAGE_LEVER_ATTRACTS_YOUR_ATTENTION;
    "";
  ],
  before
  [;
    Search:
      print "You search through the cockpit";
      if (badge notin nothing)
        ", but don't find anything else.";
      move badge to room11;
      " and find a magnetic badge hidden under one of the seats.";
  ],
has scenery;

!----------------------------------------
! Instruments
!----------------------------------------
Object "instruments" room11
with
  name 'instruments' 'instrumentation' 'complex' 'controls',
  description
  [;
    print "The instrumentation on the Discovery is not very different to the instrumentation on your own spaceship. It's just bigger and more complex.";
    if (disengage_lever hasnt general)
      print (string)DISENGAGE_LEVER_ATTRACTS_YOUR_ATTENTION;
    "";
  ],
has scenery;

!----------------------------------------
! Lever
!----------------------------------------
Object disengage_lever "lever" room11
with
  name 'disengage' 'lever',
  description
  [;
    print "When another ship is connected to the Discovery, this lever is used to disconnect them if the situation requires it, for example in certain kind of emergencies. Pulling the lever initiates the automatic sequence that separates the two ships until they reach a safe distance";
    if (self hasnt general)
      ". Since you have no way to go back to your ship via the tunnel, it might be wise to pull it.";
    else
      ", as you can see after pulling it.";
  ],
  before
  [;
    Pull:
      if (self has general)
        "You've already pulled the lever and initiated the sequence for automatic disengagement. There's no need to pull it again.";
      give self general;
      "As soon as you pull the lever the automatic disengaging sequence is initiated. With a hiss, the tunnel disconnects from the Discovery, and the distance between the two ships starts increasing steadily.";
    Push:
      "It can only be pulled.";
  ],
has scenery;

!----------------------------------------
! Seats
!----------------------------------------
Object "seats" room11
with
  name 'seats',
  description
  [;
    print "They're very comfortable and they need to be, considering the long hours of duty that a space pilot performs.";
    if (badge in nothing)
      print " Sometimes, they're so comfortable that you fall asleep and things fall out of your hands or pockets and end up underneath the seat.";
    print " ";
    <<Search self>>;
  ],
  before
  [;
    Enter:
      if (verb_word == 'lie')
        "The seat isn't long enough to lie on.";
      if (verb_word == 'stand')
        "The seat is for sitting on, not standing on.";
      "You don't have time to sit around.";
    LookUnder:
      print "You look under the seats";
      if (badge notin nothing)
        ", but don't find anything else.";
      move badge to room11;
      " and find a magnetic badge hidden under one of the seats.";
    Take:
      "The seats are securely bolted to the floor of the cockpit.";
  ],
has pluralname scenery supporter;

!----------------------------------------
! Magnetic badge
!----------------------------------------
Object badge "magnetic badge"
class Important
with
  name 'magnetic' 'badge',
  description
  [;
    print "It's a magnetic badge you found under one of the pilots' seats. It's difficult to say if it was hidden on purpose, or it just accidentally fell. There's something written on it";
    if (self hasnt general)
      print " that could be useful";
    ".";
  ],
  before
  [;
    Read:
      if (self notin player)
        print_ret (string)CANT_READ_FROM_DISTANCE;
      give badge general;
      "It says, 'Armoury'.";
  ],
has clothing;

!========================================
! Room 12: Sick Bay
!========================================
Object room12 "Sick Bay"
with
  description "The Discovery's sick bay is in turmoil. Surely this disorder is the result of the state of emergency in which the crew of the spaceship found themselves. The only exit is west.",
  w_to
  [;
    if (corpse12 hasnt general)
      StopDaemon(corpse12);
    return room05;
  ],
has;

!----------------------------------------
! Sick bay
!----------------------------------------
Object "sick bay" room12
with
  name 'sick' 'bay' 'infirmary',
  description "It's the ship's infirmary. It's small, but equipped with everything needed to cure a patient during the long journeys in space.",
has scenery;

!----------------------------------------
! Man's body
!----------------------------------------
Object corpse12 "man's body" room12
class Body
with
  name 'man' 'man^s' 'body' 'corpse' 'doctor',
  description
  [;
    print "The man, probably a doctor", (string)IS_CRUMPLED;
    if (self hasnt general)
      print_ret (string)COVERED_WITH_SORES;
    else
      print_ret (string)NOW_CHARRED;
  ],
has animate;

!----------------------------------------
! Pair of protective gloves
!----------------------------------------
Object gloves "protective gloves" room12
with
  article "a pair of",
  name 'pair' 'of' 'protective' 'gloves',
  description "It's a pair of gloves used to safely handle dangerous materials, like poisonous or corrosive substances. They are big enough to be worn over your space suit.",
  before
  [;
    Take:
      if (corpse12 hasnt general)
        print_ret (string)DEAL_WITH_CORPSE_FIRST;
  ],
has clothing pluralname;

!----------------------------------------
! Bottle of acid
!----------------------------------------
Object acid "bottle of acid" room12
with
  name 'small' 'brown' 'glass' 'bottle' 'of' 'liquid' 'acid',
  description "It's a small brown glass bottle. You can tell from the label that it contains a highly-corrosive acid, but there isn't much left.",
  before
  [;
    Drink, Taste:
      deadflag = 1;
      "Are you mad? You just drank the highly-corrosive acid. It burns your throat and starts to eat away at your innards. You gag and splutter and clutch at your throat, but the damage is done.";
    EmptyT, PutOn:
      if (second == player)
      {
        deadflag = 1;
        "Are you mad? The acid sizzles your skin and burns through your flesh down to the bone. You never were the sharpest tool in the shed and this just proves it.";
      }
      if (second ~= shockproof_container or lock)
        "You can't pour the acid on that.";
      print "You open the bottle carefully to avoid splashing yourself with the acid, then pour it over the lock. The explosive reaction spits drops of acid all over your hands";
      if (gloves hasnt worn)
      {
        deadflag = 1;
        ". Your suit wasn't made to deal with such powerful acid and it starts to melt. The pain is unbearable and you start screaming. In your rush to find some water, you trip and fall, hitting your head very hard. You lose consciousness and slowly die.";
      }
      give shockproof_container ~locked open;
      move bottle to parent(self);
      move self to limbo;
      ", but the gloves protect you. In a few minutes, the acid completely dissolves the lock and you cautiously open the container.";
    Read:
      <<Read label>>;
    Smell:
      "You can't smell anything, but the fumes burn your nose.";
    Take:
      if (corpse12 hasnt general)
        print_ret (string)DEAL_WITH_CORPSE_FIRST;
    ThrowAt:
      "Why don't you just pour the acid on ", (the)second, " so that you don't miss?";
  ],
  add_to_scope label,
has;

!----------------------------------------
! Label
!----------------------------------------
Object label "label"
with
  name 'instructions' 'label' 'warning' 'hazards' 'risks',
  description
  [;
    print "The label alerts users to the potential hazards and risks of using acid.";
    if (self hasnt general)
      print " It wouldn't hurt to read it to see what it says.";
    "";
  ],
  before
  [;
    Read:
      give self general;
      "Among all the technical gobbledegook, the label says, 'Wear protective gear before using acid'.";
  ],
has scenery;

!----------------------------------------
! Empty bottle
!----------------------------------------
Object bottle "empty bottle"
with
  name 'small' 'brown' 'glass' 'empty' 'bottle',
  article AN,
  description "It's a small brown glass bottle. You can tell from the label that it used to contain a highly-corrosive acid, but it's now empty.",
  before
  [;
    EmptyT:
      "There's no acid left in the bottle.";
    Receive:
      "You can only put liquids in the empty bottle.";
  ],
  add_to_scope label,
has;

