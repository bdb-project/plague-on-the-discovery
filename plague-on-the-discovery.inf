!----------------------------------------
! Armoury door (floating object)
!----------------------------------------
Object armoury_door "armoury door"
with
  name 'armoury' 'armory' 'door',
  description
  [;
    print "It's the door to the armoury. It's currently ";
    if (self has open)
      "open.";
    else
      "closed.";
  ],
  door_dir
  [;
    if (self in room16)
      return s_to;
    else
      return n_to;
  ],
  door_to
  [;
    if (self in room16)
      return room22;
    else
      return room16;
  ],
  with_key badge,
  found_in room16 room22,
has door openable lockable locked scenery;

