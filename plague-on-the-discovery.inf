Release 1;
Serial "261010";

!Inform 6 constants
Constant DEATH_MENTION_UNDO;
Constant MAX_CARRIED = 10;
Constant NO_SCORE;

!PunyInform constants
Constant CUSTOM_ABBREVIATIONS;
Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;
Constant OPTIONAL_FULL_DIRECTIONS;
Constant OPTIONAL_PRINT_SCENERY_CONTENTS;
Constant OPTIONAL_PROVIDE_UNDO;
Constant RUNTIME_ERRORS 0;!0 for release, 2 for debug

!PunyInform static messages
Constant MSG_COMMENT_NO_TRANSCRIPT "Comment recorded. Use SCRIPT ON to save future comments in a transcript.^";
Constant MSG_COMMENT_TRANSCRIPT "Comment recorded.^";
Constant MSG_PARSER_NO_INPUT "You need to enter a command.";
Constant MSG_PARSER_UNKNOWN_VERB "That's not a verb I recognise.";
Constant MSG_SORRY_DEFAULT "Oh, don't apologise.";
Constant MSG_WAIT_DEFAULT "Time passes...";

!PunyInform dynamic messages
Constant MSG_CLOSE_NOT_OPEN 1000;
Constant MSG_LOCK_ALREADY_LOCKED 1001;
Constant MSG_LOCK_CLOSE_FIRST 1002;
Constant MSG_LOCK_KEY_DOESNT_FIT 1003;
Constant MSG_UNLOCK_ALREADY_UNLOCKED 1004;
Constant MSG_UNLOCK_KEY_DOESNT_FIT 1005;

Constant MSG_SMELL_DEFAULT 1006;

!Game-specific constants
Constant AN "an";
Constant ARE_CRUMPLED ", are crumpled in a lifeless heap on the floor. Their bodies are ";
Constant CANT_READ_FROM_DISTANCE "You can't read it from a distance.";
Constant COVERED_WITH_SORES "covered with horrible sores and you suspect it might be very infectious.";
Constant DEAL_WITH_CORPSE_FIRST "Deal with the corpse first.";
Constant DEAL_WITH_CORPSES_FIRST "Deal with the corpses first.";
Constant IS_CRUMPLED ", is crumpled in a lifeless heap on the floor. His body is ";
Constant NOW_CHARRED "now charred and the area is sanitised.";
Constant YOU_DIE_FROM_INFECTION "Your body suddenly fills with blisters and then sores. Your vision blurs and in a few minutes it's over for you.";
Constant YOU_NOW_HAVE_PARTS_TO_MAKE_BOMB "Taken. You now have all the parts you need to make a bomb.";
Constant GAS_EXPLODES "As soon as you fire the flamethrower, the gas in the air ignites and everything is engulfed in flames...including you! The Discovery explodes, sending debris in every direction. That wasn't a very smart move on your part. Your career ends here.";
Constant DROIDS_CATCH_YOU "^You took too long to evade the droids. They found you and struck you down with their lasers. You're doomed.";
Constant DISENGAGE_LEVER_ATTRACTS_YOUR_ATTENTION " The disengage lever attracts your attention, though.";
Constant VENT_ATM "In case of emergency, the atmosphere on the Discovery can be cleared using the vent valve.";

!Replaced actions
Replace _UpdateDarkness;
Replace GoSub; !Delete if diagonal directions are used
Replace LockSub;
Replace UnlockSub;

Include "globals.h";

!Game-specific variables

!========================================
! Entry point routines
!========================================
[ ChooseObjects obj code;
  if (code == 2)
  {
    ! Stage 1: Disambiguation
    if (action_to_be == ##Close)
    {
      if (obj hasnt openable)
        return 0; !Inappropriate
      if (obj has open)
        return 1; !Appropriate
    }
    if (action_to_be == ##Lock)
    {
      if (obj hasnt lockable)
        return 0; !Inappropriate
      if (obj hasnt locked)
        return 1; !Appropriate
    }
    if (action_to_be == ##Open)
    {
      if (obj hasnt openable)
        return 0; !Inappropriate
      if (obj hasnt open)
        return 1; !Appropriate
    }
    if (action_to_be == ##Unlock)
    {
      if (obj hasnt lockable)
        return 0; !Inappropriate
      if (obj has locked)
        return 1; !Appropriate
    }
  }
  ! Stage 2: Processing an "all"
  if (obj has scenery or concealed or static or animate)
    return 2; !Force exclusion
  if (action_to_be == ##Take && obj ~= player && obj notin player)
    return 1; !Force inclusion
  if (action_to_be == ##Drop && obj in player && obj hasnt worn)
    return 1; !Force inclusion
  return 0; !Accept parser's decision
];

[ DeathMessage;
  if (deadflag == 3)
    print "You could have done better";
];

[ InScope person i;
  if (person == player && location == thedark)
    objectloop(i in real_location)
      if (i has moved)
        PlaceInScope(i);
  rfalse;
];

[ LibraryMessages p_msg p_arg_1 p_arg_2;
  switch (p_msg)
  {
    MSG_CLOSE_NOT_OPEN:
      print_ret (CTheyreOrIts)noun, " already closed.";
    MSG_LOCK_ALREADY_LOCKED:
      print_ret (CTheyreOrIts)noun, " already locked.";
    MSG_LOCK_CLOSE_FIRST:
      "You'll have to close ", (ItOrThem)noun, " first.";
    MSG_LOCK_KEY_DOESNT_FIT:
      print_ret (The)second, " ", (DoOrDoes)second, "n't fit the lock.";
    MSG_UNLOCK_ALREADY_UNLOCKED:
      print_ret (CTheyreOrIts)noun, " already unlocked.";
    MSG_UNLOCK_KEY_DOESNT_FIT:
      print_ret (The)second, " ", (DoOrDoes)second, "n't fit the lock.";
    MSG_SMELL_DEFAULT:
      if (helmet has worn)
        "The helmet prevents you from smelling the air outside.";
      if (gas hasnt general)
        "The gas has an acrid smell, making it difficult to breathe. You suspect it may be flammable.";
      else
        "You can no longer smell any gas, so the air must now be clean.";
  }
  p_arg_1 = p_arg_2;
];

Include "puny.h";

!========================================
! Initialisation
!========================================
[ Initialise;
  location = room01;
  lookmode = 2;
  move suit to player;
  no_implicit_actions = true;
  player.description = "You are Morgan Tyler, a former citizen of Thalos and now a special agent of the Earth Government. When returning to Earth after your most recent undercover assignment, you were ordered to carry out a rescue mission aboard the Discovery, but things haven't been going smoothly.";
  StartDaemon(droids); !the droids are seeking you
  StartDaemon(gas);    !and so is the gas
  "^While returning to Earth after one of your undercover missions, your superiors told you to try and find the Discovery, an exploration ship that went missing just a few days ago. You managed to find it floating adrift near the asteroid belt between Jupiter and Mars. You tried contacting the ship, but there was no response. Why did no one answer your calls? Where was the crew? Where had the ship been the last few days?^^You then contacted your superiors on Earth to notify them of your find and they instructed you to conduct a rescue mission. You carefully approached the Discovery, docked your ship, extended the pressurised boarding tunnel and entered the Discovery through the airlock. As soon as you did, a group of security droids opened fire.^^Unable to understand what was going on, but moved by your survival instinct, you sought cover and hid in the semi-dark docking bay. As the droids were now searching for you, the only way out seemed to be a metal ladder. Beyond the ladder, you might find more trouble, but this was not the time for indecision. The droids were on the hunt!^";
];

!========================================
! Classes
!========================================
Class Body
with
  short_name
  [;
    if (self has general)
      print "charred ";
    rfalse;
  ],
  life
  [;
    Ask:
      print_ret (The)self, " tell", (SingularS)self, " no tales.";
    Attack, ThrowAt:
      "Why? Let ", (the)self, " rest in peace.";
    Give:
      "Dead bodies aren't normally in the habit of accepting gifts.";
    Kiss:
      "Did you notice the condition of the corpse", (SingularS)self, "? There's something very wrong here. Not that trying to kiss ", (a)self, " is normal.";
    Show:
      print_ret (The)self, " show", (SingularS)self, " no interest in ", (the)noun, ". I wonder why?";
    Talk:
      "You strike up a conversation with ", (the)self, ", but there's no response.";
    Tell:
      print_ret (The)self, " listen", (SingularS)self, " intently to what you have to say. Or maybe not, it's hard to tell.";
    WakeOther:
      "You give ", (the)noun, " a shake, but there's no response.";
  ],
  before
  [;
    Burn:
      if (second == nothing && flamethrower in player)
      {
        print "(with the flamethrower)^";
        second = flamethrower;
      }
      if (second == nothing)
        "You don't have anything you can use to burn things.";
      if (second == pistol)
        "The pistol can shoot, but it can't burn anything.";
      if (second ~= flamethrower)
        "You can't burn anything with ", (a)second, ".";
      if (flamethrower.number == 0)
        "It looks like your flamethrower is empty.";
      if (self has general)
        "You've already burnt ", (ItOrThem)noun, " once, so save your fuel.";
      if (gas hasnt general)
      {
        deadflag = 1;
        print_ret (string)GAS_EXPLODES;
      }
      !Print the noun first, before it becomes charred
      print "You burn ", (the)noun, " with the flamethrower. ";
      flamethrower.number--;
      give self general;
      StopDaemon(self);
      "For a moment, a horrible stench of burned flesh fills the room, but an automatic system kicks in and clears the air. It's now safe to inspect the room.";
    Pull, Push, Search, Take, Touch, Turn:
      if (self has general)
        "After using the flamethrower, there's nothing worthy of your attention, apart from charred remains.";
      deadflag = 1;
      print_ret (string)YOU_DIE_FROM_INFECTION;
    Shoot:
      if (second == nothing && pistol in player)
      {
        print "(with the laser pistol)^";
        second = pistol;
      }
      if (second == nothing)
        "You don't have a weapon.";
      if (second == pistol)
        "Shooting ", (the)self, " with the laser pistol is not likely to improve the situation.";
      if (second ~= flamethrower)
        "You can't shoot anything with ", (a)second, ".";
      <<Burn self second>>;
  ],
  daemon
  [;
    switch (self.time_left++)
    {
      2: "^This looks like the result of an infectious disease. Do something to eliminate it, before it's too late.";
      4: deadflag = 1;
         print_ret "^", (string)YOU_DIE_FROM_INFECTION;
    }
  ],
  time_left 0,
has animate;

Class Important
with
  before
  [;
    Burn:
      print "This ";
      if (self hasnt general)
        print "might contain";
      else
        print "contains";
      " important information, so you'd better not burn it.";
  ],
has;

Class Lever
with
  name 'lever',
  description "It's a spring-loaded lever that's used to open or close the valve in order to flush the Discovery's atmosphere in case of an emergency.",
  before
  [ this_valve;
    switch (self)
    {
      lever05: this_valve = valve05;
      lever06: this_valve = valve06;
      lever16: this_valve = valve16;
    }
    Pull:
      if (self == lever06)
        "The lever is jammed. No matter how hard you pull, it won't budge. It looks like this valve can't be opened, but it's not the only one present inside the ship.";
      if (this_valve hasnt open)
      {
        give this_valve open;
        print "When you pull the lever, the valve opens and all the air is sucked out of the ship into the vacuum of outer space";
        if (gas hasnt general)
        {
          give gas general;
          StopDaemon(gas);
          print ", freeing the environment of the gas";
        }
        print ". The lever then springs back into place.";
        if (helmet hasnt worn)
        {
          deadflag = 1;
          "^^You suddenly realise your mistake, but it's too late. You grab your throat with your hands and try to scream, but all the air you had in your lungs is gone. Your face turns purple, then pale. Finally, you collapse to the ground, lifeless.";
        }
        StartDaemon(helmet);
        print "^^The airflow is so violent that it sends you against the wall and you hit your head hard. Wearing the helmet saved your life";
        if (helmet has general)
          print " once again";
        else
        {
          give helmet general;
          print ". However, the helmet is now damaged and it won't protect you for very long";
        }
        ". You can now close the valve and remove the helmet, if you like.";
      }
      else
      {
        give this_valve ~open;
        StopDaemon(helmet);
        "You close the valve, and an automated system quickly refills the area.";
      }
    Push:
      "It can only be pulled.";
  ],
has static;

Class TouchPanel
with
  name 'touch' 'panel',
  description
  [;
    print "The panel controls the docking bay door. You only need to touch it to open or close the door. This makes it easy to use when wearing a bulky space suit.";
    if (self has general)
      print " The panel is now smashed to pieces, so the door won't be doing any more opening or closing until someone fixes it.";
    "";
  ],
  before
  [;
    Attack:
      if (self has general)
        "You've already broken it.";
      give self general;
      print "You hit the panel, smashing it to pieces. Now no one will be able to open or close the door from this side.";
      if (self == panel02 && bay_door hasnt open)
        print " Oh, oh. Now you're locked in with the security droids!";
      "";
    Push, Touch:
      if (self has general)
        "Nothing happens, no doubt because you broke it.";
      if (bay_door has open)
      {
        give bay_door ~open;
        print "The bay door closes";
        if (location == room03 && panel02 has general)
        {
          droids.time_left = 12;
          StopDaemon(droids);
          print ". Now the security droids won't be able to get to you";
          if (~~TestScope(flamethrower))
            print ", but you won't be able to get to the flamethrower, either";
        }
        ".";
      }
      give bay_door open;
      if (location == room03 && panel02 has general)
        StartDaemon(droids);
      "The bay door opens.";
  ],
has;

Class Valve
with
  name 'ventilation' 'small' 'vent' 'valve',
  description
  [;
    print "It's a small ventilation valve used to vent the air inside the ship in case of an emergency. It's currently ";
    if (self has open)
      "open.";
    else
      "closed.";
  ],
  before
  [;
    Close:
      if (self hasnt open)
        "It's already closed.";
      else
        "It can't be closed manually. Try the lever.";
    Open:
      if (self has open)
        "It's already open.";
      else
        "It can't be opened manually. Try the lever.";
  ],
has;

!========================================
! Inventory
!========================================
!----------------------------------------
! Pressure suit
!----------------------------------------
Object suit "pressure suit"
with
  name 'pressure' 'suit',
  description
  [;
    print "It's the pressure suit you usually wear during your space travels. Since you entered the Discovery through a pressurised boarding tunnel connected to your spaceship, there was no need to take your helmet with you";
    if (helmet in player)
    {
      print ". Luckily, you were able to find a replacement on board the Discovery";
      if (helmet has general)
        print ", but it's now damaged";
    }
    ".";
  ],
  before
  [;
    Disrobe:
      "You'd better keep your suit on. You're on a spaceship that seems to have more than one problem. You don't know when you may need it.";
  ],
has clothing worn;

!========================================
! Room 1: Docking Bay
!========================================
Object room01 "Docking Bay"
with
  description "The large area you're in is the one intended for the docking and take-off of small connecting spaceships. Towards the south, an airlock leads back to your ship, but it's now closed. The only other exit is a metal ladder that leads up to a catwalk.",
  s_to "The airlock is closed and you have stuff to do. There's no time to go back.",
  u_to
  [;
    give droids scenery;
    droids.time_left = 6;
    print "You climb the ladder to escape from the droids.^^";
    return room02;
  ],
  before
  [;
    Hint:
      "Run away from the droids as soon as you can.";
  ],
has light;

!----------------------------------------
! Docking bay (floating object)
!----------------------------------------
Object "docking bay"
with
  name 'docking' 'bay' 'area' 'take-off' 'large' 'environment',
  description "It's a large environment inside the Discovery where shuttles take off and land after their exploration missions. It's currently empty and you wonder where all the shuttles have gone.",
  found_in room01 room02,
has scenery;

!----------------------------------------
! Ladder (floating object)
!----------------------------------------
Object "ladder"
with
  name 'metal' 'ladder',
  description
  [;
    print "It's a metal ladder that leads ";
    if (self in room01)
      "up to the catwalk.";
    else
      "down to the docking bay.";
  ],
  before
  [;
    Climb:
      if (self in room01)
        <<Go FAKE_U_OBJ>>;
      else
        <<Go FAKE_D_OBJ>>;
  ],
  found_in room01 room02,
has scenery;

!----------------------------------------
! Airlock
!----------------------------------------
Object "airlock" room01
with
  name 'airlock' 'opening',
  description "It's the opening that allowed you to board the Discovery from your ship. It's currently closed.",
  before
  [;
    Close:
      "It's already closed.";
    Open:
      "You just came from that direction. As you have other stuff to do, don't bother with the airlock.";
  ],
has scenery;

!----------------------------------------
! Catwalk (floating object)
!----------------------------------------
Object "catwalk"
with
  name 'catwalk',
  description "It runs above the docking bay and allows you to monitor the operations there from a safe distance.",
  found_in room01 room02,
has scenery;

!----------------------------------------
! Security droids (floating object)
!----------------------------------------
Object droids "security droids"
with
  article "a patrol of",
  name 'patrol' 'of' 'surveillance' 'security' 'droids',
  description "These droids are normally active during the crew's hybernation period, when they are employed in basic surveillance and monitoring tasks. Something seems to have gone wrong, as they now appear to be in seek-and-destroy mode.",
  before
  [;
    Attack, Burn, Shoot:
      if (second == nothing)
        "You should tell me what you want to use for this action.";
      if (second == pistol)
        "A laser pistol is useless against an entire patrol of droids.";
      if (second == flamethrower)
      {
        deadflag = 1;
        if (gas hasnt general)
          print_ret (string)GAS_EXPLODES;
        else
          "The flames slow down the droids for a moment, but then they resume their patrol and, having intercepted you, they kill you on the spot.";
      }
    Take:
      "Do you have a death wish? The droids are in seek-and-destroy mode.";
  ],
  daemon
  [;

    switch (self.time_left++)
    {
      !0 to 5 are in docking bay
      0: "^The security droids are looking for you.";
      2: "^The security droids have sensed your presence and are zooming in on you.";
      4: "^The security droids have tracked you down and are approaching fast. You'd better do something before it's too late.";
      5: deadflag = 1;
        print_ret (string)DROIDS_CATCH_YOU;
      !6 to 12 are on catwalk
      6: "^The security droids look confused. Their prey has seemingly disappeared.";
      7: "^The security droids are looking for you.";
      9: give self ~scenery;
      "^The security droids have sensed your presence and are climbing up the ladder.";
      11: "^The security droids have tracked you down and are approaching fast. You'd better do something before it's too late.";
      12: if (location == room02)
          {
            deadflag = 1;
            print_ret (string)DROIDS_CATCH_YOU;
          }
          if (bay_door hasnt open && panel02 hasnt general)
            print "^The bay door opens, the";
          else
            print "^The";
          deadflag = 1;
          " security droids stream in and strike you down with their lasers.";
    }
  ],
  time_left 0,
  found_in room01 room02,
has pluralname animate;

!----------------------------------------
! Gas (floating object)
!----------------------------------------
Object gas "gas"
with
  name 'gas',
  description
  [;
    print "You can't see the gas. ";
    <<Smell>>;
  ],
  before
  [;
    Smell:
      <<Smell>>;
  ],
  daemon
  [;
    if (helmet hasnt worn)
      "^There's a distinct smell of gas in the air.";
  ],
  found_in
  [;
    rtrue;
  ],
has scenery;

!========================================
! Room 2: Catwalk above Docking Bay
!========================================
Object room02 "Catwalk above Docking Bay"
with
  description "The narrow catwalk you're now on is connected to the docking and takeoff area of the Discovery by a metal ladder. A door leads east. Below you, in the docking area, you can see the security droids searching for you. You can go down using the ladder, but some of the droids are heading in your direction.",
  e_to bay_door,
  d_to
  [;
    print "You can't ";
    if (droids has scenery)
      print "go back to the docking bay";
    else
      print "get to the ladder";
    " or the droids will kill you.";
  ],
  before
  [;
    Hint:
      if (panel02 hasnt general)
        "Sometimes violence is the answer.";
  ],
has light;

!----------------------------------------
! Docking bay door (floating object)
!----------------------------------------
Object bay_door "docking bay door"
with
  name 'docking' 'bay' 'west' 'door',
  description
  [;
    print "It's the door to the ";
    if (player in room02)
      print "inside of the Discovery";
    else
      print "docking bay";
    print ". It's currently ";
    if (self has open)
      "open.";
    else
      "closed.";
  ],
  door_dir
  [;
    if (self in room02)
      return e_to;
    else
      return w_to;
  ],
  door_to
  [;
    if (self in room03)
      return room02;
    else
      return room03;
  ],
  before
  [;
    Close:
      if (self hasnt open)
        "It's already closed.";
      else
        "You can't close it manually.";
    Open:
      if (self has open)
        "It's already open.";
      else
        "You can't open it manually.";
  ],
  found_in room02 room03,
has door openable scenery;

!----------------------------------------
! Touch panel
!----------------------------------------
Object panel02 "touch panel" room02
class TouchPanel
has static;

!----------------------------------------
! Flamethrower
!----------------------------------------
Object flamethrower "flamethrower" room02
with
  name 'flamethrower' 'flame' 'thrower',
  description
  [;
    print "It's a deadly weapon that you've used before";
    if (self.number == 3 && tank.number == 3)
      print ", but you wonder why such a weapon would be present on a civilian exploration ship.";
    else
      print " and it's come in handy once again.";
    " A gauge on the flamethrower indicates how much fuel is available.";
  ],
  before
  [;
    Fill:
      "Maybe you meant 'load'?";
    Load:
      if (second == nothing && tank in player)
      {
        print "(with the fuel tank)^";
        second = tank;
      }
      if (second == nothing)
        "You don't have anything to load it with.";
      if (second ~= tank)
        "You can't very well load the flamethrower with ", (a)second, ".";
      if (self.number == 3)
        "You don't need to load the flamethrower yet as it is fully loaded."; 
      if (tank.number == 0)
        "The fuel tank is now empty, and you can't use it to load the flamethrower any more.";
      ! determining how much fuel can fit in the thrower
      self.max_cap = 3 - self.number;
      if (tank.number < max_cap)
      {
        self.number = self.number + self.max_cap;
        tank.number = tank.number - self.max_cap;
      }
      else
      {
        self.number = self.number + tank.number;
        tank.number = 0;
      }
      "You load the flamethrower with the contents of the fuel tank.";
  ],
  number 3,
  max_cap 0, 
  add_to_scope gauge,
has;

!----------------------------------------
! Gauge
!----------------------------------------
Object gauge "gauge"
with
  name 'gauge',
  description
  [;
    print "It tells you how much fuel is left in the flamethrower. According to the gauge, it's currently ";
    switch (flamethrower.number)
    {
      0: print"empty. ";
         if (tank hasnt moved)
           "You'd better find some more fuel.";
         "";
      1: "one-third full.";
      2: "two-thirds full.";
      3: "full.";
    }
  ],
  before
  [;
    Read:
      <<Examine self>>;
  ],
has scenery;

!========================================
! Room 3: Central Deck Corridor
!========================================
Object room03 "Central Deck Corridor"
with
  description "You're in a corridor with exits in all the four cardinal directions. The south and west exits have doors. From this position you can also go up or down.",
  n_to room04,
  s_to navigation_door,
  e_to room06,
  w_to bay_door,
  u_to room05,
  d_to room16,
  before
  [;
    Go:
      if (selected_direction ~= w_to && panel02 hasnt general)
        "You'd better find a way to stop those droids before they find you and kill you. They are programmed to seek and destroy.";
    Hint:
      if (panel02 hasnt general)
        "Sometimes violence is the answer, but not here.";
  ],
has light;

!----------------------------------------
! Corridor
!----------------------------------------
Object "corridor" room03
with
  name 'central' 'deck' 'corridor',
  description "It's a pivot point that connects different rooms on this level and allows access to the upper and lower one.",
has scenery;

!----------------------------------------
! Touch panel
!----------------------------------------
Object panel03 "touch panel" room03
class TouchPanel
has static;

!----------------------------------------
! Navigation room door (floating object)
!----------------------------------------
Object navigation_door "navigation room door"
with
  name 'navigation' 'nav' 'room' 'door',
  description
  [;
    print "It's the door ";
    if (self in room03)
      print "to";
    else
      print "from";
    print" the navigation room. It's currently ";
    if (self has open)
      "open.";
    else
      "closed.";
  ],
  door_dir
  [;
    if (self in room03)
      return s_to;
    else
      return n_to;
  ],
  door_to
  [;
    if (self in room03)
      return room23;
    else
      return room03;
  ],
  with_key electronic_key,
  found_in room03 room23,
has door lockable locked openable scenery;

!========================================
! Room 4: Storeroom
!========================================
Object room04 "Storeroom"
with
  description "You're in a small room whose function is easy to guess. The shelf and the containers scattered here and there reveal that it's a storeroom. The only exit is towards the south.",
  s_to room03,
has light;

!----------------------------------------
! Storeroom
!----------------------------------------
Object "storeroom" room04
with
  name 'storeroom',
  description "A few containers, once safely secured to avoid inadvertent movement, are now scattered around.",
has scenery;

!----------------------------------------
! Containers
!----------------------------------------
Object "containers" room04
with
  name 'containers' 'materials' 'supply' 'goods',
  description "The containers hold different types of materials and supplies.",
  before
  [;
    Open, Search:
      "Don't bother with them.";
  ],
has pluralname scenery;

!----------------------------------------
! Shelf
!----------------------------------------
Object shelf "shelf" room04
with
  name 'small' 'shelf',
  description
  [;
    give self general;
    print "It's a small shelf, suitable for placing small objects on. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Pressure helmet
!----------------------------------------
Object helmet "pressure helmet" shelf
with
  name 'pressure' 'helmet',
  description
  [;
    print "The helmet completes the suit and provides full protection ";
    if (helmet has worn)
      print "now that";
    else
      print "when";
    print " it's worn.";
    if (self has general)
      print " However, after you banged your head, it's now damaged and you're not sure that it can fulfill its intended purpose if chemicals or pathogens be present in the air.";
    "";
  ],
  after
  [;
    Disrobe:
      if (valve05 has open || valve16 has open)
      {
        deadflag = 1;
        "You remove the helmet, but remember too late that you never closed the valve. You try to put it back on, but the total absence of air knocks you about. In a matter of seconds and you collapse to the ground, lifeless.";
      }
      if (gas has general)
        "When you remove the helmet, you realise you can't smell the gas any more. The leak must have been in the docking bay, which is now locked, so you probably won't have any more troubles with the gas.";
    Take:
      if (detonator in nothing)
      {
        move detonator to location;
        move paper to location;
        "As soon as you take the helmet, something hidden inside it falls to the floor.";
      }
  ],
  daemon
  [;
    switch (self.time_left++)
    {
      9: "^Your helmet, already damaged when you banged your head, becomes more and more ineffective. Did you forget to close the ventilation valve?";
      14: "^Your helmet is now damaged beyond repair. You'd better do something soon.";
      19: deadflag = 1;
         "^Your damaged helmet can no longer resist the decompressed environment. It explodes, exposing you to zero atmosphere. The air is rapidly sucked out from your lungs, then you start freezing due to the extremely low temperature. It looks like your journey is over.";
    }
  ],
  time_left 0,
has clothing;

!----------------------------------------
! Detonator
!----------------------------------------
Object detonator "detonator"
with
  name 'detonator',
  description
  [;
    print "It's a detonator with a button on top";
    if (explosive notin player)
      ", but it's useless without some explosive to connect it to.";
    else
      ". As you've already got some explosive, you now have all the components you need to make a bomb.";
  ],
  after
  [;
    Take:
      if (explosive in player)
        print_ret (string)YOU_NOW_HAVE_PARTS_TO_MAKE_BOMB;
  ],
  add_to_scope button,
has;

!----------------------------------------
! Button
!----------------------------------------
Object button "button"
with
  name 'button',
  description "It looks like you press the button to activate the detonator.",
  before
  [;
    Push:
      "Nothing happens. The detonator needs to be connected to some explosive before you can activate it.";
  ],
has scenery;

!----------------------------------------
! Scrap of paper
!----------------------------------------
Object paper "scrap of paper"
with
  name 'scrap' 'of' 'paper',
  description
  [;
    print "It's a scrap of paper that someone had hidden inside the helmet.";
    if (self hasnt general)
      print " There's something written on it, so you should probably read it.";
    "";
  ],
  before
  [;
    Read:
      if (self notin player)
        print_ret (string)CANT_READ_FROM_DISTANCE;
      give self general;
      "'DESTROY THIS SHIP!' Who might have written such a message? The captain, perhaps?";
  ],
has;

!========================================
! Room 5: Upper Deck Corridor
!========================================
Object room05 "Upper Deck Corridor"
with
  description "The corridor in which you now find yourself leads to the north, south, east and west in various rooms of the Discovery. You can also go down to the lower floors of the ship.",
  n_to
  [;
    if (corpse13 hasnt general)
    {
      corpse13.time_left = 0;
      StartDaemon(corpse13);
    }
    return room13;
  ],
  s_to room15,
  e_to
  [;
    if (corpse12 hasnt general)
    {
      corpse12.time_left = 0;
      StartDaemon(corpse12);
    }
    return room12;
  ],
  w_to room14,
  d_to room03,
  before
  [;
    Hint:
      print_ret (string)VENT_ATM;
  ],
has light;

