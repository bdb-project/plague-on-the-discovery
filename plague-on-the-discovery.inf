has scenery;

!----------------------------------------
! Laser pistol
!----------------------------------------
Object pistol "laser pistol" room22 !item03
with
  name 'laser' 'pistol',
  description "It's a laser pistol. It doesn't look very helpful in your current predicament. In retrospect, you wonder whether you could have used it on the security droids.",
has;

!----------------------------------------
! Shockproof container
!----------------------------------------
Object shockproof_container "shockproof container" room22
with
  name 'shockproof' 'container',
  description
  [;
    print "It's a huge shockproof container. ";
    if (self hasnt open)
      "The big lock on it keeps it safely closed. Given how sturdy it is, it must hold something very important...or very dangerous.";
    print "Now that you've burned the lock with the acid, the container is open. ";
    <<Search self>>;
  ],
  before
  [;
    Close:
      if (self has locked)
        "It's already closed.";
      else
        "You can't, as the lock's been melted.";
    Lock:
      if (self has locked)
        "It's already locked.";
      else
        "You just melted the lock, so you won't be able to lock it again.";
    Open:
      if (self has open)
        "It's already open.";
      else
        "You'll have to get past the lock first.";
    Shoot:
      "I don't think it's a smart move shooting inside an armoury.";
    Take:
      "You don't need the container, only what it contains.";
    Unlock:
      if (self hasnt locked)
        "It's already unlocked.";
      print "The big lock requires a special key";
      if (note hasnt general)
        ". Given the mess you've seen so far, it might have been lost.";
      else
        ", but, as you know from the captain's note, he's destroyed it.";
  ],
has container locked openable static;

!----------------------------------------
! Big lock
!----------------------------------------
Object lock "big lock" room22
with
  name 'big' 'lock',
  description
  [;
    print "It's quite an impressive lock. ";
    if (shockproof_container hasnt open)
      "How are you going to unlock it without a key?";
    else
      "Or it was, until you melted it with the acid. Now it's useless.";
  ],
  before
  [;
    Close:
      <<Close shockproof_container>>;
    Lock:
      <<Lock shockproof_container>>;
    Open:
      <<Open shockproof_container>>;
    Shoot:
      <<Shoot shockproof_container>>;
    Unlock:
      <<Unlock shockproof_container>>;
  ],
has scenery;

!----------------------------------------
! Explosive
!----------------------------------------
Object explosive "explosive" shockproof_container
with
  article "some",
  name 'large' 'quantity' 'of' 'high-explosive' 'high' 'explosive',
  description
  [;
    print "It's a large quantity of high-explosive. Judging by the amount, the crew of the Discovery must have also dealt with mineral extraction.";
    if (detonator in player)
      print " As you've already got a detonator, you now have all the components you need to make a bomb.";
    "";
  ],
  after
  [;
    Take:
      if (detonator in player)
        print_ret (string)YOU_NOW_HAVE_PARTS_TO_MAKE_BOMB;
  ],
has;

!----------------------------------------
! Fuel tank
!----------------------------------------
Object tank "fuel tank" room22
with
  name 'fuel' 'tank',
  description
  [;
    print "It's a fuel tank.";
    if (self in player)
    {
      print " Judging by the weight, it";
      if (self.number == 3)
        print "'s full, so you can use it to load a flamethrower.";
      if ((self.number == 2) || (self.number == 1))
        print " still has some fuel in it, so you can load the flamethrower.";
      if (self.number == 0)
        print "'s empty, but that's not surprising, as you used it to load the flamethrower. As it's now useless, you can discard it.";
    }
    "";
  ],
  before
  [;
    Insert:
      if (second == flamethrower)
        <<Load second self>>;
  ],
  number 3,
has;

!========================================
! Room 23: Navigation Room
!========================================
Object room23 "Navigation Room"
with
  description "You're in the navigation room of the Discovery where a large mainframe shines with an unreal light. On the screen, a small cursor winks, making the green phosphors shine. A chart on the wall depicts the area of interest for the present mission. When you're done here, you can exit the room via the northern door.",
  n_to navigation_door,
has light;

!----------------------------------------
! Navigation room
!----------------------------------------
Object "navigation room" room23
with
  name 'navigation' 'room',
  description "It's not very wide, and the computer inside fills it almost completely.",
has scenery;

!----------------------------------------
! Chart
!----------------------------------------
Object "chart" room23
with
  name 'chart',
  description "It looks like the scope of this mission was to explore the Guyoth System. Markings on the chart seem to indicate that the Discovery was returning from Guyoth IV, a young Earth-like planet, that's still evolving.",
has scenery;

!----------------------------------------
! Video screen
!----------------------------------------
Object "screen" room23
with
  name 'video' 'screen' 'green' 'phosphors' 'cursor',
  description "The cursor flashing on the video is mesmerising.",
  before
  [;
    Read:
      <<Read data>>;
  ],
has scenery;

!----------------------------------------
! Computer
!----------------------------------------
Object computer "computer" room23
class Important
with
  name 'computer' 'mainframe',
  description
  [;
    print "The Discovery's on-board computer still works. A slot in it allows you to insert a storage device to transfer data. The last data entry concerns the spaceship's log and contains a lot of scientific information about the pathogen that's attacked the crew. ";
    if (flash_drive has general)
      "That information is now backed up on your flash drive.";
    else
      "It might be wise to transfer the data to a storage device.";
  ],
  before
  [;
    Attack:
      "Although you could do that, there's no need to waste your time in such a useless endeavour.";
    Read:
      give self general;
      <<Read data>>;
  ],
has scenery;

!----------------------------------------
! Slot
!----------------------------------------
Object slot23 "slot" room23
with
  name 'small' 'slot',
  description
  [;
    print "It's a small slot used to connect storage devices to the computer. When such a device is in the slot, you can transfer data to the computer. ";
    <<Search self>>;
  ],
  before
  [;
    Receive:
      if (noun ~= flash_drive)
        "You can't fit ", (a)noun, " in the slot.";
  ],
has container open static;

!----------------------------------------
! Data
!----------------------------------------
Object data "data" room23
with
  name 'data' 'entry' 'log',
  description
  [;
    print "This is highly scientific information, and there's a lot of it. You could never learn it by heart, but ";
    if (flash_drive hasnt general)
      "you could transfer it to a dedicated storage device.";
    else
      "now you don't have to, as it's safely stored on the flash drive.";
  ],
  before
  [;
    Transfer:
      if (flash_drive notin slot23)
        "You can't transfer data to a storage device unless it's in the appropriate slot.";
      if (flash_drive has general)
        "You've already transfered the data. There's no need to do it again.";
      give flash_drive general;
      print "You quickly transfer the data to the flash drive. While doing so, you read through the most interesting parts as they appear on the screen.^^";
      <<Read self>>;
    Read:
      "During an exploration mission, the crew landed on an uncharted, and apparently lifeless, planet. While digging its surface to collect soil samples, they found a new organism. Despite all the precautions taken to keep those samples isolated, an infection spread across the ship. In an attempt to counteract the disease, the ambient temperature was lowered to almost zero degrees Celsius. An initial vaccine was developed, but the crew must have died before the tests could be completed. During the development of the vaccine, the droids entered seek-and-destroy mode for some unknown reason. This may have been a malfunction or it may have been the droids' AI trying to defend the ship against all infectious personnel.";
  ],
has scenery;

!========================================
! Room 24: Escape Pod
!========================================
Object room24 "Escape Pod"
with
  description "You've just entered an escape pod of the Discovery. It's barely big enough to accommodate a single person. In front of you, you can see a small control panel. The only way out is up.",
  u_to room10,
has light;

!----------------------------------------
! Escape pod
!----------------------------------------
Object "escape pod" room24
with
  name 'escape' 'pod',
  description "With your spaceship out of reach in the docking bay, this escape pod is your only way out of this nightmare. It's pre-programmed to fly towards Earth on the shortest possible route.",
has scenery;

!----------------------------------------
! Control panel
!----------------------------------------
Object "control panel" room24
with
  name 'control' 'panel' 'instruments',
  description "The control panel is nothing more than a few instruments to monitor the flight path and a release button to separate it from the Discovery.",
has scenery;

!----------------------------------------
! Release button
!----------------------------------------
Object "release button" room24
with
  name 'release' 'button',
  description "It's the button that, when pressed, initiates the release sequence from the Discovery. After separation, an automated system sends the pod on a route to Earth.",
  before
  [;
    Push:
      if (~~TestScope(flash_drive) || flash_drive hasnt general)
        "You're missing important information that you need to take back to Earth.";
      if (~~TestScope(vial))
        "You can't leave without the vaccine.";
      if (bomb notin room07)
        "You need to set the bomb to destroy the Discovery.";
      print "The first thing you hear after pressing the release button is a loud 'BANG'. That makes your heart sink, then you feel a strong acceleration and realise that the bang came from the microcharges that separate the escape pod from the Discovery.^^Looking outside the porthole, you see the Discovery becoming smaller and then it explodes. You have to look away, as the explosion is as bright as a small sun.^^Next to the explosion, ";
      if (disengage_lever has general)
      {
        deadflag = 2;
        print "but now at a safe distance, you see your spaceship. You'll think about how to retrieve it in due course.";
      }
      else
      {
        deadflag = 3;
        print "you see that your spaceship is still connected by the pressurised tunnel and it too is caught in the explosion. You're going to have a problem explaining this to his boss.";
      }
      "^^You have possibly prevented a contagion and, even though the pathogen might have infected you, the vial and the data that you now have on the flash drive should be enough to develop a vaccine.^^As the light from the burning Discovery fades away, you take a moment to study the control panel in the escape pod. Everything seems to be working correctly - the course towards Earth is set, the emergency beacon is transmitting your position and the flow of oxygen is steady. You also find some emergency rations below the seat. You tear a snack bag open, relax and wait for the Search and Rescue Unit to arrive.";
  ],
has scenery;

!========================================
! Limbo
!========================================
Object limbo;

!========================================
! Printing rules
!========================================
[ consultWord word i;
  for (i=0:i<WordLength(word):i++)
    print (char)LowerCase(WordAddress(word)->i);
];

[ firstConsultWord word i;
  for (i=0:i<WordLength(word):i++)
    if (i == 0)
      print (char)UpperCase(WordAddress(word)->i);
    else
      print (char)LowerCase(WordAddress(word)->i);
];

!========================================
! Other routines
!========================================
[ _UpdateDarkness p_silent _ceil _old_darkness _darkness;
  if (location == thedark)
    _old_darkness = true;
  _ceil = ScopeCeiling(player);
  if (_LookForLightInObj(_ceil, _ceil) == false)
    _darkness = true;
  if (_darkness ~= _old_darkness)
    scope_modified = true;
  if (_darkness)
    location = thedark;
  else
    location = real_location;
  if (_darkness ~= _old_darkness && p_silent == false)
  {
    new_line;
    <Look>;
  }
];

[ CantBeShot;
  if (noun == player)
    "Are you feeling suicidal?";
  if (noun == gas)
    "You can't shoot the gas directly.";
  if (second == nothing && flamethrower in player)
  {
    print "(with the flamethrower)^";
    second = flamethrower;
  }
  rfalse;
];

[ LowerCase c; ! for ZSCII matching ISO 8859-1
  switch (c)
  {
    'A' to 'Z': c = c + 32;
    202, 204, 212, 214, 221: c--;
    217, 218: c = c - 2;
    158 to 160, 167, 168, 208 to 210: c = c - 3;
    186 to 190, 196 to 200: c = c - 5 ;
    175 to 180: c = c - 6;
  }
  return c;
];

[ UpperCase c; ! for ZSCII matching ISO 8859-1
  switch (c)
  {
    'a' to 'z': c = c - 32;
    201, 203, 211, 213, 220: c++;
    215, 216: c = c + 2;
    155 to 157, 164, 165, 205 to 207: c = c + 3;
    181 to 185, 191 to 195: c = c + 5 ;
    169 to 174: c = c + 6;
  }
  return c;
];

!========================================
! Grammar
!========================================
[ isMakeable;
  if (scope_stage == 1)
    rfalse;!Don't allow multiple objects
  if (scope_stage == 2)
  {
    PlaceInScope(bomb);
    rfalse;
  }
  if (scope_stage == 3)
    "You don't know how to make that.";
];

Extend 'ask'
  * 'about' topic -> AskAbout;

Extend 'lock' first
  * noun -> Lock;

Extend 'look'
  * 'into' noun -> Search
  * 'behind'/'under' noun -> LookUnder;

Extend 'read' first
  * noun -> Read;

Extend only 'say' first
  * topic -> Say;

Extend only 'speak' replace
  * -> Talk
  * creature -> Talk
  * noun -> Talk
  * 'to'/'with' creature -> Talk
  * 'to'/'with' noun -> Talk
  * 'to'/'with' creature 'about' topic -> Ask
  * 'to'/'with' noun 'about' topic -> Ask;

Extend 'unlock' first
  * noun -> Unlock;

Verb meta 'about' 'info'
  * -> About;

Verb meta 'credits'
  * -> Credits;

Verb meta 'help' 'instructions'
  * -> Help;

Verb 'copy' 'write' = 'transfer';

Verb 'hint' 'clue'
  * -> Hint;

Verb 'inspect' = 'examine';

Verb 'load'
  * noun -> Load
  * noun 'with' held -> Load;

Verb 'make'
  * scope=isMakeable -> Make
  * scope=isMakeable 'with' held -> Make;

Verb 'play'
  * -> Play
  * noun -> Play
  * 'with' noun -> Play;

Verb 'pour' = 'empty';

Verb 'shoot'
  * -> Shoot
  * held -> Shoot
  * 'with' held -> Shoot
  * noun -> Shoot
  * noun 'with' held -> Shoot
  * 'at' noun -> Shoot
  * 'at' noun 'with' held -> Shoot
  * held 'at' noun -> Shoot reverse;

Verb 'talk' 'babble' 'chat' 'communicate' 'converse' 'gab' 'gossip'
  * -> Talk
  * creature -> Talk
  * noun -> Talk
  * 'to'/'with' creature -> Talk
  * 'to'/'with' noun -> Talk
  * 'to'/'with' creature 'about' topic -> Ask
  * 'to'/'with' noun 'about' topic -> Ask;

Verb 'use'
  * noun -> Use;

Verb 'xyzzy' 'plover' 'plugh' 'yoho'
  * -> MagicWord;

!========================================
! Actions
!========================================
[ AboutSub;
  print "This game is an adaptation of the Italian adventure 'Morgan Tyler: Star Plague' by Bonaventura Di Bello. It was originally written using The Quill and Illustrator and published by Edizioni Hobby S.r.l. on the cover tape of 'Viking', no. 4, April 1987 for the ZX Spectrum and Commodore 64.^^The data was extracted from the C64 version using UnQuill, translated to English and rewritten for a modern audience with the original author's permission. The new version includes many enhancements that weren't in the original. The coding was done using Inform 6 and the PunyInform library.^^";
  <<Credits>>;
];

[ AskAboutSub x count npc;
  objectloop (x in location && x has animate && x ~= player)
  {
    count++;
    npc = x;
  }
  if (count == 0)
    "There's no one here to answer your questions.";
  if (count == 1)
    <<Ask npc noun>>;
  "As there are multiple characters here, you'll have to specify who to ask, e.g. ASK MAN ABOUT DOG.";
];

[ CreditsSub;
  "Original concept, game design and coding by Bonaventura Di Bello.^Technical assistance by Max Di Bello.^English translation and game skeleton by Garry Francis.^Game redesign and coding by Gianluca Girelli.^Play testing by Andrew Schultz, Charles Moore, Garry Francis, Jade, Pablo Martinez and Robert Eggleston.";
];

!Delete GoSub if diagonal directions are used
[ GoSub _prop;
  if (selected_direction == ne_to or nw_to or se_to or sw_to)
    "There are no diagonal directions in this game.";
  _prop = selected_direction;
#Iftrue RUNTIME_ERRORS > RTE_MINIMUM;
  if (_prop == 0)
    return _RunTimeError(ERR_INVALID_DIR_PROP);
#Endif;
  return GoDir(_prop);
];

[ HelpSub;
  "Tell me what to do using simple commands starting with a verb.^^Use LOOK (or L) to refresh the location description. Identify all the objects in the description and EXAMINE (or X) each one. Read responses carefully for hints.^^Use compass directions (N, S, E, W, U and D) to move around. Draw a map as you go.^^Use GET or TAKE to take objects and DROP to drop them again. Use WEAR to wear things like clothing and REMOVE to remove anything that's currently worn. Use INVENTORY (or I) to see what you're carrying and wearing.^^Use AGAIN (or G) to repeat the last command.^^Use UNDO to undo the last command if you make a mistake.^^Use SAVE to save the game and RESTORE to restore it again.^^There are over 100 verbs that you can use, so if something doesn't work, try a different verb or a different way of doing things. Use HINT if you get stuck.^^For full instructions, see the game page at <https://bdb-project.itch.io/plague-on-the-discovery>.";
];

[ HintSub;
  "Examine everything you find and draw a map.";
];

[ LoadSub;
  if (ObjectIsUntouchable(noun))
    rtrue;
  "That would be a neat trick.";
];

[ LockSub k;
  if (ObjectIsUntouchable(noun))
    rtrue;
  if (noun hasnt lockable)
  {
    PrintMsg(MSG_LOCK_NOT_A_LOCK, 'lock');
    rtrue;
  }
  if (noun has locked)
  {
    PrintMsg(MSG_LOCK_ALREADY_LOCKED);
    rtrue;
  }
  if (noun has open)
  {
    PrintMsg(MSG_LOCK_CLOSE_FIRST);
    rtrue;
  }
  k = RunRoutines(noun, with_key);
  if (k == nothing)
    "You can't see how to lock ", (ItOrThem)noun, ".";
  if (second == nothing && k ~= nothing && k in player)
  {
    second = k;
    print "(with ", (the)second, ")^";
  }
  if (second == nothing)
    "You don't have the key.";
  if (second ~= k)
  {
    PrintMsg(MSG_LOCK_KEY_DOESNT_FIT);
    rtrue;
  }
  give noun locked;
  run_after_routines_msg = MSG_LOCK_DEFAULT;
  run_after_routines_arg_1 = 'lock';
];

[ LookUnderSub;
  if (location == thedark)
    "But it's dark.";
  "You find nothing of interest.";
];

[ MagicWordSub;
  "You start chanting the magic word, but soon stop when you realise that instead of help or inspiration you just get horrible visions of dying planets.";
];

[ MakeSub;
  "You don't have the materials required to make ", (ThatOrThose)noun, ".";
];

[ PlaySub;
  if (noun == nothing)
    "What do you want to play with?";
  if (ObjectIsUntouchable(noun))
    rtrue;
  "This is no time to be playing around with ", (the)noun, ".";
];

[ ReadSub;
  if (ObjectIsUntouchable(noun))
    rtrue;
  "There's nothing legible on ", (ThatOrThose)noun, ".";
];

[ SaySub i;
  if (consult_words == 0)
    "You have nothing to say.";
  print "~";
  i = consult_from;
  print (firstConsultWord)i++;
  while (i < consult_from + consult_words)
    print " ", (consultWord)i++;
  print ".~^^";
  wn = consult_from;
  if (consult_words == 1 && NextWord() == 'xyzzy' or 'plover' or 'plugh' or 'yoho')
    <<MagicWord>>;
  if (AfterRoutines())
    rtrue;
  "Nothing happens.";
];

[ ShootSub;
  if (noun == nothing)
    "You point your finger in the air and say, ~Bang!~";
  if (ObjectIsUntouchable(noun))
    rtrue;
  if (CantBeShot())
    rtrue;
  "You can't just go around shooting things arbitrarily.";
];

[ TalkSub;
  if (noun == nothing)
    "You start talking to no one in particular.";
  if (noun == player)
    "You start talking to yourself, but it's a one-sided conversation.";
  if (RunLife(noun, ##Talk))
    rtrue;
  print_ret (The)noun, " ", (IsOrAre)noun, " not very talkative.";
];

[ UnlockSub k;
  if (ObjectIsUntouchable(noun))
    rtrue;
  if (noun hasnt lockable)
  {
    PrintMsg(MSG_UNLOCK_NOT_A_LOCK, 'unlock');
    rtrue;
  }
  if (noun hasnt locked)
  {
    PrintMsg(MSG_UNLOCK_ALREADY_UNLOCKED, 'unlock');
    rtrue;
  }
  k = RunRoutines(noun, with_key);
  if (k == nothing)
    "You can't see how to unlock ", (ItOrThem)noun, ".";
  if (second == nothing && k ~= nothing && k in player)
  {
    second = k;
    print "(with ", (the)second, ")^";
  }
  if (second == nothing)
    "You don't have the key.";
  if (second ~= k)
  {
    PrintMsg(MSG_UNLOCK_KEY_DOESNT_FIT);
    rtrue;
  }
  give noun ~locked;
  run_after_routines_msg = MSG_UNLOCK_DEFAULT;
  run_after_routines_arg_1 = 'unlock';
];

[ UseSub;
  if (ObjectIsUntouchable(noun))
    rtrue;
  "You'll have to be more explicit than that.";
];

End;
