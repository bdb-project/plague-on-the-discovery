!----------------------------------------
! Electronic key
!----------------------------------------
Object electronic_key "electronic key" room18
class Important
with
  article AN,
  name 'electronic' 'key',
  description
  [;
    print "It's an electronic key, shaped like a card. It seems to be one of those cards used to give access to important places. There's something written on it";
    if (self hasnt general)
      print " that could be useful";
    ".";
  ],
  before
  [;
    Read:
      if (self notin player)
        print_ret (string)CANT_READ_FROM_DISTANCE;
      give self general;
      "The writing on the card says, 'Navigation Room'.";
    Take:
      if (corpse18 hasnt general)
        print_ret (string)DEAL_WITH_CORPSES_FIRST;
  ],
has;

!========================================
! Room 19: Kitchen
!========================================
Object room19 "Kitchen"
with
  description
  [;
    print "The kitchen, a small room directly connected to the north with the mess room, is also empty. ";
    if (helmet has worn)
      print "If you weren't wearing your helmet, you'd probably smell a faint odour of synthetic foods pervading the air.";
    else
      print "A faint smell of synthetic foods pervades the air, giving the impression that nothing has happened on board the Discovery in the last few days, or certainly the last few hours.";
    " When you're done here, you can go back to the mess hall by going north.";
  ],
  n_to room18,
  before
  [;
    Smell:
      if (helmet has worn)
        "If you weren't wearing your helmet, you'd probably smell a faint odour of synthetic foods pervading the air.";
      else
        "A faint smell of synthetic foods pervades the air, but you don't feel like eating at the moment.";
  ],
has light;

