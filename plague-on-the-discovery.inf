Object "board game" gaming_tables
with
  name 'board' 'game',
  description "This board game refers to dungeons, dragons and a plethora of weird characters who roam forested lands in search of treasure. Clearly, the Discovery's crew was fed up with the emptiness of space and sought escape in a fantasy world.",
  before
  [;
    Play:
      "You spend a couple of minutes fiddling with the game. Then remember that you've got work to do, so you leave it for later.";
    Take:
      "I agree that it's a nice game, but you don't have time for playing.";
  ],
has static;

