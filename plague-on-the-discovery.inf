!----------------------------------------
! Control unit
!----------------------------------------
Object "control unit" room06
with
  name 'control' 'unit',
  description "It regulates the main functions on the ship, including the environmental temperature that is, at present, very low. You try to raise it a little bit, but soon realise that it's a waste of time, so you desist.",
  before
  [;
    Attack:
      "In a moment of anger you consider smashing the unit into pieces, but it wouldn't do any good, so you take a little breath and move on.";
    Take:
      "Even if you could take it, you have no use for it.";
  ],
has static;

!========================================
! Room 7: Engine Room
!========================================
Object room07 "Engine Room"
with
  description "You've reached a large, dimly-lit room where enormous cylinders of metal hum continuously. This is the engine room of the Discovery, whose only exit is up towards the central hub.",
  u_to
  [;
    if (bomb in player && dummy_button has general)
      "Are you crazy? Are you going to take an active bomb with you? Leave it here, where it will be most effective!";
    return room06;
  ],
  before
  [;
    Hint:
      if (note has general)
        "As the captain said, blow up the engine if the situation requires it.";
      "Someone might have left instructions for dealing with the engine.";
  ],
has light;

!----------------------------------------
! Engine room
!----------------------------------------
Object "engine room" room07
with
  name 'large' 'dimly-lit' 'engine' 'room',
  description "The place is dirty and semi-dark. Just as any other engine room you've seen before.",
has scenery;

!----------------------------------------
! Engine
!----------------------------------------
Object "engine" room07
with
  article "the",
  name 'engine' 'enormous' 'cylinders' 'of' 'metal',
  description "This is what allows the Discovery to travel across and beyond the Solar System at nearly light-speed. None of this matters at the moment.",
  before
  [;
    Attack:
      "You can't destroy the engine in this way. You need something far more powerful.";
    Burn:
      "If it catches fire you'll have no escape.";
  ],
has static;

!----------------------------------------
! Slot
!----------------------------------------
Object slot07 "slot" room07
with
  name 'small' 'slot',
  description
  [;
    print "It's a small slot used to hold an emergency light. ";
    <<Search self>>;
  ],
  before
  [;
    Receive:
      if (noun ~= emergency_light)
        print_ret (The)noun, " won't fit in the slot.";
  ],
  after
  [;
    Receive:
      if (noun == emergency_light)
      {
        give noun ~light;
        "When you put the emergency light back in the slot, it automatically turns off.";
      }
    LetGo:
      if (noun == emergency_light)
      {
        give noun light;
        "When you take the emergency light out of the slot, it automatically turns on.";
      }
  ],
has container open static;

!----------------------------------------
! Emergency light
!----------------------------------------
Object emergency_light "emergency light" slot07
with
  article AN,
  name 'emergency' 'light',
  description
  [;
    print "It's a battery-powered emergency light. It's currently ";
    if (self has light)
      "on.";
    else
      "off.";
  ],
  before
  [;
    SwitchOff:
      if (self hasnt light)
        "It's already off.";
      else
        "You can't turn it off manually.";
    SwitchOn:
      if (self has light)
        "It's already on.";
      else
        "You can't turn it on manually.";
  ],
has;

!----------------------------------------
! Bomb
!----------------------------------------
Object bomb "bomb"
with
  name 'bomb',
  description "It's the bomb you made by connecting the detonator to the explosive. A button on the detonator allows you to activate it.",
  before
  [;
    Make:
      if (self notin nothing)
        "You've already made the bomb.";
      if (explosive notin player || detonator notin player)
        "You're missing some parts to make a bomb.";
      move explosive to limbo;
      move detonator to limbo;
      move bomb to player;
      "You connect the detonator to the explosive to make a bomb. You can now activate it by pressing the button on top of the detonator.";
  ],
  daemon
  [;
    switch (self.time_left++)
    {
      0: "^The bomb is now active and will go off soon.";
      3: "^Time is ticking away. Hurry up!";
      5: deadflag = 1;
         "^You wasted too much time. The bomb you placed in the engine room goes off and triggers a chain-reaction that destroys the Discovery, deck after deck. You might have preserved Earth from the plague, but, without the data extracted from the computer, others might come and make the same mistake as the crew of the Discovery. This time, you weren't up to the task. Next time, well, there won't be a next time, will there?";
    }
  ],
  time_left 0,
  add_to_scope dummy_button dummy_detonator dummy_explosive,
has;

!----------------------------------------
! Dummy button on detonator
!----------------------------------------
Object dummy_button "button"
with
  name 'button',
  description "It's the button that triggers the bomb. If you press it, the bomb will go off in a matter of minutes.",
  before
  [;
    Drop, Take:
      "It's part of the detonator. You can't separate it.";
    Push:
      if (location ~= room07)
        "If the bomb isn't placed in the right location there's a chance the Discovery will not be destroyed and the plague might survive.";
      if (self has general)
        "You've already pressed the button and the bomb has been activated. You'd better run for your life.";
      give self general;
      StartDaemon(bomb);
      "BOOM! Just kidding, but you'd better run...and fast!";
  ],
has scenery;

!----------------------------------------
! Dummy detonator
!----------------------------------------
Object dummy_detonator "detonator"
with
  name 'detonator',
  description "It's connected to the explosive, so you're now dealing with a bomb that can be activated by pushing the button on the detonator. Be careful with it.",
  before
  [;
    Drop, Take:
      "You can't separate the detonator from the explosive now that you've made the bomb.";
  ],
has scenery;

!----------------------------------------
! Dummy explosive
!----------------------------------------
Object dummy_explosive "explosive"
with
  name 'explosive',
  description "It's connected to the detonator, so you're now dealing with a bomb that can be activated by pushing the button. Be careful with it.",
  before
  [;
    Drop, Take:
      "You can't separate the explosive from the detonator now that you've made the bomb.";
  ],
has scenery;

!========================================
! Room 8: Pilots' Quarters
!========================================
Object room08 "Pilots' Quarters"
with
  description "The pilots' quarters is a narrow space in the hull where the pilots rest during off-duty periods or when they can rely on the auto-pilot. The only exit is to the south.",
  s_to
  [;
    if (corpse08 hasnt general)
      StopDaemon(corpse08);
    return room06;
  ],
has;

!----------------------------------------
! Pilots' quarters
!----------------------------------------
Object "pilots' quarters" room08
with
  name 'pilots^' 'quarters',
  description "It's a small but comfortable space, suitable for getting some rest after a heavy shift.",
has scenery;

!----------------------------------------
! Man's body
!----------------------------------------
Object corpse08 "man's body" room08
class Body
with
  name 'man' 'man^s' 'body' 'corpse' 'pilot',
  description
  [;
    print "This man, possibly one of the pilots", (string)IS_CRUMPLED;
    if (self hasnt general)
      print_ret (string)COVERED_WITH_SORES;
    else
      print_ret (string)NOW_CHARRED;
  ],
has animate;

!----------------------------------------
! Captain's note
!----------------------------------------
Object note "captain's note" room08
class Important
with
  name 'captain' 'captain^s' 'note',
  description
  [;
    print "It's the note you found in the pilots' quarters.";
    if (self hasnt general)
      print " It might be worth reading it.";
    "";
  ],
  before
  [;
    Read:
      if (self notin player)
        print_ret (string)CANT_READ_FROM_DISTANCE;
      give self general;
      "'In the last few days the disease has spread throughout the entire ship. It must be something we accidentaly picked up on Guyoth IV, where we lost part of our crew. One of the symptoms is mental instability and someone could do something stupid while I'm still trying to plot a route towards the Sun. That's why, for the time being, I removed the detonator from the armoury and hid it somewhere else. Also, I destroyed the access key to the explosives cache. Should I fail in modifying the route, my last resort is to blow up the engine. This will cause a chain-reaction that will destroy the Discovery and, hopefully, the pathogen.' Well, this explains a lot of things.";
    Take:
      if (corpse08 hasnt general)
        print_ret (string)DEAL_WITH_CORPSE_FIRST;
  ],
has;

!========================================
! Room 9: Crew's Quarters
!========================================
Object room09 "Crew's Quarters"
with
  description "This is a large room intended for the accommodation of the on-board personnel, but it's a real mess. There are items of clothing thrown in a heap, personal belongings scattered on the floor and the wall lockers are all open. You can go back to the central hub to the north.",
  n_to room06,
has light;

!----------------------------------------
! Crew's quarters
!----------------------------------------
Object "crew's quarters" room09
with
  name 'crew^s' 'quarters' 'large' 'room',
  description "The place is a total mess. You doubt you'll find anything useful here.",
has scenery;

!----------------------------------------
! Heap of clothes
!----------------------------------------
Object "heap of clothes" room09
with
  name 'heap' 'of' 'clothes' 'clothing' 'mess',
  description "It's a heap of clothes, thrown across the room for no reason.",
  before
  [;
    Search:
      "You search through the clothes, but don't find anything useful.";
  ],
has pluralname scenery;

!----------------------------------------
! Personal belongings
!----------------------------------------
Object "personal belongings" room09
with
  name 'personal' 'belongings' 'purses' 'backpacks',
  description "It includes items like purses, backpacks and books scattered all over the place, but nothing of any use to you.",
  before
  [;
    Search:
      "You search through the personal belongings, but don't find anything useful.";
  ],
has pluralname scenery;

!----------------------------------------
! Books
!----------------------------------------
Object "books" room09
with
  name 'books',
  description "Some of them are novels, others are technical manuals, but you doubt that any of them are of any help to you at the moment.",
  before
  [;
    Read:
      "You flip through the pages of a couple of books, but you really have no time for this, so you put them back.";
    Search:
      "You search through the pages of some of the books, but don't find anything useful.";
  ],
has pluralname scenery;

!----------------------------------------
! Wall lockers
!----------------------------------------
Object "wall lockers" room09
with
  name 'wall' 'lockers',
  description "The lockers possibly contained all the items that are now scattered on the floor, as if someone was in an extreme hurry had tried to take what they could before leaving.",
  before
  [;
    Close:
      "Don't waste your time with the lockers. Leave them how you found them.";
    Search:
      "You search the lockers, but you don't find anything useful. A few of them have amusing posters pinned inside.";
  ],
has container openable open pluralname scenery;

!----------------------------------------
! Posters
!----------------------------------------
Object "posters" room09
with
  name 'posters' 'pictures' 'pin-ups',
  description "Judging from the pictures, the Discovery must have been in service for a long time, as some of the models in those pin-ups have now retired.",
  before
  [;
    Take:
      "You have no use for posters.";
  ],
has pluralname scenery;

!========================================
! Room 10: Emergency Area
!========================================
Object room10 "Emergency Area"
with
  description "You've entered the area where the crew dons their space suits before exiting the ship for maintenance or accessing the escape pods in an emergency. The corridor unfolds east to west. From here you can also go down.",
  e_to room11,!Conditional, see below
  w_to
  [;
    if (corpse10 hasnt general)
      StopDaemon(corpse10);
    return room06;
  ],
  d_to room24,!Conditional, see below
  before
  [;
    Go:
      if (selected_direction == e_to or d_to && corpse10 hasnt general)
        "You can't get past the corpse while it's infectious.";
  ],
has light;

!----------------------------------------
! Emergency area
!----------------------------------------
Object "emergency area" room10
with
  name 'emergency' 'area' 'corridor',
  description "This corridor should hold the space suits for the crew, but it's now empty.",
has scenery;

!----------------------------------------
! Man's body
!----------------------------------------
Object corpse10 "man's body" room10
class Body
with
  name 'man' 'man^s' 'body' 'corpse' 'technician',
  description
  [;
    print "The man, probably a technician performing his duties in the emergency room", (string)IS_CRUMPLED;
    if (self hasnt general)
      print_ret (string)COVERED_WITH_SORES;
    else
      "now charred, and the area sanitised.";
  ],
