  [;
    print "It's a high-density storage device used for recording data so that it can be transferred between computers.";
    if (self has general)
      print " It now contains the data concerning the alien pathogen. If you take the data to Earth, they might be able to find a cure for it.";
    "";
  ],
  before
  [;
    Read:
      "You can't read what's on it unless you plug it into a computer.";
    Take:
