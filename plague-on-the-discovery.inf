Object "strategic meeting room" room21
with
  name 'strategic' 'meeting' 'room',
  description "It looks like something important was going on here.",
has scenery;

!----------------------------------------
! Furniture
!----------------------------------------
Object "furniture" room21
with
  name 'furniture' 'large' 'table' 'chairs',
  description "The most prominent feature is a big table with chairs, but there's nothing special about them so don't bother.",
has scenery;

!----------------------------------------
! Whiteboard
!----------------------------------------
Object whiteboard "whiteboard" room21
class Important
with
  name 'whiteboard' 'white' 'board',
  description
  [;
    print "The whiteboard is the only feature on the walls. There's some writing on it";
    if (self hasnt general)
      print " that you haven't read yet";
    ".";
  ],
  before
  [;
    Read:
      give self general;
      "Despite the shaky handwriting, likely due to haste or the progression of the disease, you can make out what's written. It seems that the crew, having inadvertently brought a pathogen aboard while exploring the Guyoth system, attempted to find a cure for the disease, but was unsuccessful. As the research showed an increased and uncontrollable acceleration in the pathogen's evolution, a course was plotted toward the Sun in a last-ditch effort to prevent the disease from reaching Earth.^^Evidently, the progression of the disease had destroyed the crew's mental faculties, as their calculations appear to be flawed. It seems the only solution now is to destroy the ship, since the pathogen's infection and mortality rate seems to be 100%.";
  ],
has scenery;

!----------------------------------------
! Walls
!----------------------------------------
Object "walls" room21
with
  name 'wall' 'walls',
  description "There's a whiteboard mounted on the wall opposite the exit.",
  before
  [;
    Read:
      "Try the whiteboard.";
  ],
has scenery;

!----------------------------------------
! Writing
!----------------------------------------
Object "writing" room21
with
  name 'writing',
  description
  [;
    print "It looks like it was written during an emergency meeting.";
    if (whiteboard hasnt general)
      print " You should read it.";
    "";
  ],
  before
  [;
    Read:
      <<Read whiteboard>>;
  ],
has scenery;

!----------------------------------------
! Men's bodies
!----------------------------------------
Object corpse21 "men's bodies" room21
class Body
with
  name 'men' 'men^s' 'bodies' 'corpses',
  description
  [;
    print "A few men, probably senior members of the expedition gathered for an important meeting", (string)ARE_CRUMPLED;
    if (self hasnt general)
      print_ret (string)COVERED_WITH_SORES;
    else
      print_ret (string)NOW_CHARRED;
  ],
has animate pluralname;

!----------------------------------------
! Report
!----------------------------------------
Object report "report" room21
class Important
with
  name 'infection' 'report',
  description
  [;
    print "It's a report, containing data about an unknown pathogen.";
    if (self hasnt general)
      print " You should read it, even if you think you've already figured out what was going on aboard the ship.";
    "";
  ],
  before
  [;
    Read:
      if (self notin player)
        print_ret (string)CANT_READ_FROM_DISTANCE;
      give self general;
      "'...the pathogen, isolated from samples retrieved on Guyoth IV, is highly infectious and attacks the host destroying the organs from within. The initial symptoms are a marked decline in higher intellectual faculties, skin eruptions with infectious sores and blisters...'^^The report continues with a massive list of disgusting symptoms that you don't really want to read about.";
    Take:
      if (corpse21 hasnt general)
        print_ret (string)DEAL_WITH_CORPSES_FIRST;
  ],
has;

!========================================
! Room 22: Armoury
!========================================
Object room22 "Armoury"
with
  description "The space in the armoury has been emptied and the shelves removed, probably before departure. This may have been to provide additional storage, given the scientific nature of the expedition. Normally, it would have been equipped with large shelves on which weapons and ammunition of all types were placed. From here you can only go north.",
  n_to armoury_door,
  before
  [;
    Hint:
      if (shockproof_container hasnt open)
        "I remember seeing a movie where metal couldn't withstand acid.";
  ],
has light;

