!----------------------------------------
! Vial
!----------------------------------------
Object vial "vial" cabinet
with
  name 'vial' 'filled' 'with' 'blue' 'liquid',
  description
  [;
    print "The vial is filled with blue liquid";
    if (flash_drive hasnt general)
      ", but you have no idea what it is.";
    else
      ". Now that you've read the data while transfering it to the flash drive, you think the blue liquid might be the vaccine to the plague. You'd better keep it safe and take it with you back to Earth.";
  ],
  before
  [;
    Drink:
      print "You'd better not";
      if (flash_drive hasnt general)
        ", as you don't know what it is.";
      else
        ". It's the only sample and someone on Earth may need it to produce more.";
    Open:
      print "You'd better not, as you don't ";
      if (flash_drive hasnt general)
        "know what it is.";
      else
        "want to risk spilling it.";
  ],
has;

